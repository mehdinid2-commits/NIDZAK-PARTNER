{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User business metadata mapping plans and stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "businessId": { "type": "number" },
        "name": { "type": "string" },
        "migrated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "businessId", "name"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Customer service reservation details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "business_id": { "type": "number" },
        "client_id": { "type": "number" },
        "staff_id": { "type": "number" },
        "service_id": { "type": "number" },
        "date": { "type": "string" },
        "start_time": { "type": "string" },
        "status_id": { "type": "number" }
      },
      "required": ["id", "client_id", "staff_id", "service_id", "date"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact and notes registry document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/users/{userId}/profile": {
      "schema": "User",
      "description": "The custom tenant account overview state"
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "All customer bookings for this tenant owner"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "All clients associated with this business owner"
    }
  }
}
