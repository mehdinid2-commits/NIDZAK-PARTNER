rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny to enforce strict zero-trust by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared global validation/auth primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // System tables metadata collection for secure full-system backend synchronization
    match /system_tables/{tableId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'system-database-sync@nidzak.com';
    }

    // Fortress core match block: Isolates and secures all business/SaaS items by the authenticated owner's UID
    match /users/{userId} {
      // Profile and settings root documents
      allow read, write: if isOwner(userId);

      match /profile {
        allow read, write: if isOwner(userId);
      }

      match /appointments/{appointmentId} {
        allow read, write: if isOwner(userId);
      }

      match /customers/{customerId} {
        allow read, write: if isOwner(userId);
      }

      match /vehicles/{vehicleId} {
        allow read, write: if isOwner(userId);
      }

      match /services/{serviceId} {
        allow read, write: if isOwner(userId);
      }

      match /employees/{employeeId} {
        allow read, write: if isOwner(userId);
      }

      match /payments/{paymentId} {
        allow read, write: if isOwner(userId);
      }

      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /analytics/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }

      match /promotions/{promotionId} {
        allow read, write: if isOwner(userId);
      }

      match /giftcards/{giftcardId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
